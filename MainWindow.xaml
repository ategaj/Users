<Window x:Class="Users.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Users"
        mc:Ignorable="d"
       Title="MainWindow" Height="450" Width="892" FontFamily="Arial Black" FontSize="14">
    <DockPanel Background="#FF596C86">
        <WrapPanel Name="LeftPanel" IsEnabled="False" DockPanel.Dock="Left" Width="329" Background="White" >
            <TextBox x:Name="NameInput" Width="150" Height="30" HorizontalAlignment="left" Margin="20 20 0 0"/>
            <TextBlock Text="Имя" Margin="10 25 0 0"/>
            <TextBox x:Name="MailInput" Width="150" Height="30" HorizontalAlignment="left" Margin="20 20 0 0"/>
            <TextBlock Text="Email" Margin="10 25 0 0"/>
            <TextBox x:Name="PasswordInput" Width="150" Height="30" HorizontalAlignment="left" Margin="20 20 0 0"/>
            <TextBlock Text="Пароль" Margin="10 25 0 0"/>
            <TextBox x:Name="PhoneInput" Width="150" Height="30" HorizontalAlignment="left" Margin="20 20 0 0"/>
            <TextBlock Text="Телефон" Margin="10 25 0 0"/>
            <ComboBox  x:Name="RoleInput" SelectedIndex="0" Width="150" Height="30" HorizontalAlignment="Left" Margin="20 20 0 0">
            </ComboBox>
            <TextBlock Text="Роль" Margin="10 25 0 0"/>
            <DatePicker x:Name="DateInput"  Width="150" Height="30" HorizontalAlignment="Left" Margin="20 20 0 0"/>
            <TextBlock Text="Дата рождения" Margin="10 25 0 0"/>
            <Button Name="LeftButton" Background="#FFD3D4DA" HorizontalAlignment="Center" Height="20" Width="170" Margin="80 20 0 0" Click="Append"   />
        </WrapPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom"  Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="DeleteButton" Content="Удалить" Width="160" Height="20" Margin="5" IsEnabled="False" Click="Delete"/>
                <Button x:Name="EditButton" Content="Изменить" Width="160" Height="20" Margin="5" IsEnabled="False" Click="Edit"/>
                <Button x:Name="AddButton" Content="Добавить" Width="160" Height="20" Margin="5" Click="Add"/>
            </StackPanel>
            <TabControl DockPanel.Dock="Top" x:Name="UsersTabControl" Background="#FFC8DAE2">
                <TabItem Header="Пользователи" >
                    <ListBox x:Name="UsersListBox" Background="#FFC8DAE2" SelectionChanged="ListBox_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Менеджеры">
                    <ListBox x:Name="ManagersListBox" Background="#FFC8DAE2" SelectionChanged="ListBox_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Администраторы">
                    <ListBox x:Name="AdminsListBox" Background="#FFC8DAE2" SelectionChanged="ListBox_SelectionChanged"/>
                </TabItem>
                <TabItem Header="Все пользователи">
                    <ListBox x:Name="AllUsersListBox" Background="#FFC8DAE2" SelectionChanged="ListBox_SelectionChanged"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</Window>
